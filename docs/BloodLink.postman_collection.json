{
  "info": {
    "name": "BloodLink API",
    "_postman_id": "bloodlink-api-collection",
    "description": "API коллекция для системы управления донорством крови BloodLink",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Аутентификация и авторизация",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin@hospital.com",
                  "description": "Email пользователя"
                },
                {
                  "key": "password",
                  "value": "admin",
                  "description": "Пароль"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Авторизация пользователя. Возвращает роль и устанавливает session cookie."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logout"]
            },
            "description": "Выход из системы"
          },
          "response": []
        },
        {
          "name": "Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/csrf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "csrf"]
            },
            "description": "Получить CSRF токен для защищённых запросов"
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Получить информацию о текущем авторизованном пользователе"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Blood Requests",
      "description": "Управление запросами крови",
      "item": [
        {
          "name": "Get Requests for Bank",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blood-requests/bank?bloodGroup=&rhesusFactor=&reverse=false&page=0&size=10&sort=id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blood-requests", "bank"],
              "query": [
                {
                  "key": "bloodGroup",
                  "value": "",
                  "description": "Фильтр по группе крови (1-4 или пусто)"
                },
                {
                  "key": "rhesusFactor",
                  "value": "",
                  "description": "Фильтр по резусу (POSITIVE/NEGATIVE или пусто)"
                },
                {
                  "key": "reverse",
                  "value": "false",
                  "description": "Обратная сортировка"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "id"
                }
              ]
            },
            "description": "Получить запросы крови для сотрудника банка. Требуется роль BANK_EMPLOYEE."
          },
          "response": []
        },
        {
          "name": "Get Requests for Medical",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/blood-requests/medical?status=&page=0&size=10&sort=id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blood-requests", "medical"],
              "query": [
                {
                  "key": "status",
                  "value": "",
                  "description": "Фильтр по статусу (PENDING/ACCEPTED/REJECTED или пусто)"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "id"
                }
              ]
            },
            "description": "Получить запросы крови для медицинского сотрудника. Требуется роль MEDICAL_EMPLOYEE."
          },
          "response": []
        },
        {
          "name": "Create Blood Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}",
                "description": "CSRF токен"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodGroup\": 1,\n  \"rhesusFactor\": \"POSITIVE\",\n  \"volumeNeeded\": 500,\n  \"urgency\": \"HIGH\",\n  \"organizationsIds\": [1, 2]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/blood-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blood-requests"]
            },
            "description": "Создать новый запрос крови. Требуется роль MEDICAL_EMPLOYEE."
          },
          "response": []
        },
        {
          "name": "Accept Blood Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/blood-requests/1/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blood-requests", "1", "accept"]
            },
            "description": "Принять запрос крови. Требуется роль BANK_EMPLOYEE."
          },
          "response": []
        },
        {
          "name": "Reject Blood Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Недостаточно запасов\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/blood-requests/1/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "blood-requests", "1", "reject"]
            },
            "description": "Отклонить запрос крови. Требуется роль BANK_EMPLOYEE."
          },
          "response": []
        }
      ]
    },
