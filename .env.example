# BloodLink Environment Variables
# Copy this file to .env and fill in the values

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=BloodLink
DB_USERNAME=admin
DB_PASSWORD=your_secure_password_here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5353

# Spring Profile (dev, docker, prod)
SPRING_PROFILES_ACTIVE=dev
